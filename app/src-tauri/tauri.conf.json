{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chaptr",
  "version": "0.1.3",
  "identifier": "dev.chaptr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "chaptr",
        "width": 1600,
        "height": 950
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NkM3QUJDRDExQ0E3QkMKUldTOHB4elJ2SHBzS1cwVElqU3cxNU00R1d5MmYxSlkvNTRLNkZNS0pPR3hQREZYV1RYQXVEWi8K",
      "endpoints": [
        "https://github.com/Sirsyorrz/chaptr/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "licenseFile": "../../LICENSE-THIRD-PARTY.md",
    "resources": {
      "bin/ffmpeg/*": "bin/ffmpeg/",
      "bin/whisper/*": "bin/whisper/",
      "bin/llama/*": "bin/llama/"
    }
  }
}
